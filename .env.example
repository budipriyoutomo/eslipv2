APP_NAME="E-Slip"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL / MariaDB (same engine as the legacy app)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eslip_v2
DB_USERNAME=eslip
DB_PASSWORD=

# Legacy CodeIgniter database, read-only, used by `php artisan eslip:import-legacy`
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=eslip
LEGACY_DB_USERNAME=
LEGACY_DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Default mailer (fallback). Each company picks its own mailer via `companies.mailer`.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hrd@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Mailer: smtp_bogajabar
MAIL_BOGAJABAR_SCHEME=smtps
MAIL_BOGAJABAR_HOST=mail.example.com
MAIL_BOGAJABAR_PORT=465
MAIL_BOGAJABAR_USERNAME=
MAIL_BOGAJABAR_PASSWORD=

# Mailer: smtp_maharasa
MAIL_MAHARASA_SCHEME=smtps
MAIL_MAHARASA_HOST=mail.example.com
MAIL_MAHARASA_PORT=465
MAIL_MAHARASA_USERNAME=
MAIL_MAHARASA_PASSWORD=

# Mailer: smtp_gmail (use an App Password, not the account password)
MAIL_GMAIL_SCHEME=smtp
MAIL_GMAIL_HOST=smtp.gmail.com
MAIL_GMAIL_PORT=587
MAIL_GMAIL_USERNAME=
MAIL_GMAIL_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
