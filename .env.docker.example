# Environment for docker-compose.yml. Copy to .env.docker (never commit it).
#   cp .env.docker.example .env.docker

APP_NAME="E-Slip"
APP_ENV=production
# Generate: docker compose run --rm --no-deps --entrypoint php app artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single,stderr
LOG_LEVEL=info

# --- PostgreSQL (service "db"). DB_* and POSTGRES_* must match. ---
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=eslip_v2
DB_USERNAME=eslip
DB_PASSWORD=ganti-password-ini

POSTGRES_DB=eslip_v2
POSTGRES_USER=eslip
POSTGRES_PASSWORD=ganti-password-ini

# Legacy CodeIgniter DB (MySQL), only for `php artisan eslip:import-legacy`.
# From the container, a MySQL on the host is reachable as host.docker.internal.
LEGACY_DB_HOST=host.docker.internal
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=eslip
LEGACY_DB_USERNAME=
LEGACY_DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# Set to true once the site is served over HTTPS.
SESSION_SECURE_COOKIE=false

CACHE_STORE=database
QUEUE_CONNECTION=database
# Must stay above SendPayslipJob::$timeout (120 s).
DB_QUEUE_RETRY_AFTER=180
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# --- Mail ---
# Trial: every company mailer points to Mailpit (http://localhost:8025), nothing reaches employees.
# Production: use the real SMTP host/port/scheme/credentials per account.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS="hrd@example.com"
MAIL_FROM_NAME="E-Slip"

MAIL_BOGAJABAR_SCHEME=smtp
MAIL_BOGAJABAR_HOST=mailpit
MAIL_BOGAJABAR_PORT=1025
MAIL_BOGAJABAR_USERNAME=
MAIL_BOGAJABAR_PASSWORD=

MAIL_MAHARASA_SCHEME=smtp
MAIL_MAHARASA_HOST=mailpit
MAIL_MAHARASA_PORT=1025
MAIL_MAHARASA_USERNAME=
MAIL_MAHARASA_PASSWORD=

MAIL_GMAIL_SCHEME=smtp
MAIL_GMAIL_HOST=mailpit
MAIL_GMAIL_PORT=1025
MAIL_GMAIL_USERNAME=
MAIL_GMAIL_PASSWORD=

# --- Payslip sending ---
ESLIP_MAIL_PER_MINUTE=20
ESLIP_QUEUE=payslips
# Parallel run with real SMTP: send everything to a test inbox instead of the employees.
ESLIP_MAIL_OVERRIDE_TO=
