# Environment for docker-compose.yml. Copy to .env.docker (never commit it).
#   cp .env.docker.example .env.docker

APP_NAME="E-Slip"
APP_ENV=production
# Generate: docker compose run --rm app php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
# Use the public domain once nginx-proxy-manager forwards to port 8004.
APP_URL=http://localhost:8004
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single,stderr
LOG_LEVEL=info

# --- PostgreSQL: existing container `maharasa-postgres`, reached over network `posgresql_default`. ---
# Create the database once, see docs/deploy/DOCKER.md.
DB_CONNECTION=pgsql
DB_HOST=maharasa-postgres
DB_PORT=5432
DB_DATABASE=eslip_v2
DB_USERNAME=eslip
DB_PASSWORD=ganti-password-ini

# Legacy CodeIgniter DB (MySQL), only for `php artisan eslip:import-legacy`.
# The MySQL 8 container on this server publishes host port 3308.
LEGACY_DB_HOST=host.docker.internal
LEGACY_DB_PORT=3308
LEGACY_DB_DATABASE=eslip
LEGACY_DB_USERNAME=
LEGACY_DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# Set to true once the site is served over HTTPS.
SESSION_SECURE_COOKIE=false

CACHE_STORE=database
QUEUE_CONNECTION=database
# Must stay above SendPayslipJob::$timeout (120 s).
DB_QUEUE_RETRY_AFTER=180
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# --- Mail: one SMTP account per mailer; each company picks its mailer in menu PT. ---
# Default mailer (fallback only).
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hrd@example.com"
MAIL_FROM_NAME="E-Slip"

MAIL_BOGAJABAR_SCHEME=smtps
MAIL_BOGAJABAR_HOST=mail.example.com
MAIL_BOGAJABAR_PORT=465
MAIL_BOGAJABAR_USERNAME=
MAIL_BOGAJABAR_PASSWORD=

MAIL_MAHARASA_SCHEME=smtps
MAIL_MAHARASA_HOST=mail.example.com
MAIL_MAHARASA_PORT=465
MAIL_MAHARASA_USERNAME=
MAIL_MAHARASA_PASSWORD=

# Gmail: use an App Password, not the account password.
MAIL_GMAIL_SCHEME=smtp
MAIL_GMAIL_HOST=smtp.gmail.com
MAIL_GMAIL_PORT=587
MAIL_GMAIL_USERNAME=
MAIL_GMAIL_PASSWORD=

# --- Payslip sending ---
ESLIP_MAIL_PER_MINUTE=20
ESLIP_QUEUE=payslips
# TRIAL / parallel run: every payslip goes to this test inbox instead of the employees.
# Empty it only when going live.
ESLIP_MAIL_OVERRIDE_TO=

# Run `migrate --force` every time the container starts.
RUN_MIGRATIONS=true
